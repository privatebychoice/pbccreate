{{define "content"}}
<p><a href="/content">← Back to board</a></p>

<h1>{{.Item.Title}}</h1>
<p class="muted">{{.Item.ChannelName}} · {{humanize .Item.Type}}{{if .Item.Mode}} · {{humanize .Item.Mode}}{{end}}</p>

<form method="post" action="/content/{{.Item.ID}}/status" class="inline-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="return_to" value="/content/{{.Item.ID}}">
  <label for="status">Status</label>
  <select id="status" name="status">
    {{range .Statuses}}<option value="{{.}}"{{if eq . $.Item.Status}} selected{{end}}>{{humanize .}}</option>{{end}}
  </select>
  <button type="submit">Update status</button>
</form>

<dl class="meta">
  <dt>Status</dt><dd>{{humanize .Item.Status}}</dd>
  <dt>Created</dt><dd>{{if not .Item.CreatedAt.IsZero}}{{.Item.CreatedAt.Format "2006-01-02 15:04"}}{{end}}</dd>
  <dt>Updated</dt><dd>{{if not .Item.UpdatedAt.IsZero}}{{.Item.UpdatedAt.Format "2006-01-02 15:04"}}{{end}}</dd>
</dl>

<section aria-labelledby="checklist-heading">
  <h2 id="checklist-heading">Pre-publish checklist
    {{if .ChecklistReady}}<span class="badge-ready">Ready</span>{{else}}<span class="badge-blocked">Not ready</span>{{end}}
  </h2>
  <ul class="prepublish">
    {{range .Checklist}}
    <li class="check-{{.State}}">
      <span class="check-icon" aria-hidden="true">{{if eq (printf "%s" .State) "ok"}}✓{{else if eq (printf "%s" .State) "fail"}}✗{{else}}—{{end}}</span>
      <span class="sr-only">{{if eq (printf "%s" .State) "ok"}}Pass:{{else if eq (printf "%s" .State) "fail"}}Needs attention:{{else}}Not applicable:{{end}}</span>
      <span><strong>{{.Label}}</strong> <span class="muted">{{.Detail}}</span></span>
    </li>
    {{end}}
  </ul>
  <p class="muted">Output-file recording and marking the item published (with override) arrive with the publication record.</p>
</section>

<section aria-labelledby="script-heading">
  <h2 id="script-heading">Script</h2>
  <p class="muted">{{.Script.WordCount}} words · ~{{.Script.DurationLabel}} at {{.Script.WPM}} wpm</p>
  <form method="post" action="/content/{{.Item.ID}}/script" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="body">Script / voiceover</label>
      <textarea id="body" name="body" rows="16" autocomplete="off">{{.Script.Body}}</textarea>
    </p>
    <p>
      <label for="wpm">Words per minute</label>
      <input id="wpm" name="wpm" type="number" min="1" max="500" value="{{.Script.WPM}}">
    </p>
    <p><button type="submit">Save script</button></p>
  </form>
</section>

<section aria-labelledby="outline-heading">
  <h2 id="outline-heading">Outline / Layout</h2>
  <p class="muted">Total target: {{duration .OutlineTotalSeconds}}</p>

  {{if .Segments}}
  <ol class="outline">
    {{range .Segments}}
    <li>
      <div class="seg-head">
        <strong>{{.Title}}</strong>
        <span class="muted">start ~{{duration .StartSeconds}} · target {{if .TargetSeconds}}{{duration .TargetSeconds}}{{else}}—{{end}}</span>
      </div>
      {{if .Notes}}<p class="muted seg-notes">{{.Notes}}</p>{{end}}
      <div class="card-actions">
        <form method="post" action="/content/{{$.Item.ID}}/outline/{{.ID}}/move">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="dir" value="up">
          <button type="submit" aria-label="Move '{{.Title}}' up">↑</button>
        </form>
        <form method="post" action="/content/{{$.Item.ID}}/outline/{{.ID}}/move">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="dir" value="down">
          <button type="submit" aria-label="Move '{{.Title}}' down">↓</button>
        </form>
        <form method="post" action="/content/{{$.Item.ID}}/outline/{{.ID}}/delete">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit" aria-label="Delete '{{.Title}}'">Delete</button>
        </form>
      </div>
    </li>
    {{end}}
  </ol>
  {{else}}
  <p>No segments yet. Add the first one below.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/outline" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="seg-title">Segment title</label>
      <input id="seg-title" name="title" required maxlength="200" autocomplete="off">
    </p>
    <p>
      <label for="seg-notes">Notes</label>
      <textarea id="seg-notes" name="notes" rows="2" autocomplete="off"></textarea>
    </p>
    <p>
      <label for="seg-target">Target seconds</label>
      <input id="seg-target" name="target_seconds" type="number" min="0" max="86400" value="0">
    </p>
    <p><button type="submit">Add segment</button></p>
  </form>
</section>

<section aria-labelledby="shots-heading">
  <h2 id="shots-heading">Shot list</h2>

  {{if .Shots}}
  <ol class="shots">
    {{range .Shots}}
    <li>
      <div class="seg-head">
        <strong>{{.Description}}</strong>
        <form method="post" action="/content/{{$.Item.ID}}/shots/{{.ID}}/status" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <label class="sr-only" for="shot-status-{{.ID}}">Status</label>
          <select id="shot-status-{{.ID}}" name="status">
            {{$cur := .Status}}
            {{range $.ShotStatuses}}<option value="{{.}}"{{if eq . $cur}} selected{{end}}>{{humanize .}}</option>{{end}}
          </select>
          <button type="submit">Set</button>
        </form>
      </div>
      {{if or .Scene .Framing .Camera}}
      <div class="muted">
        {{with .Scene}}scene: {{.}}{{end}}
        {{with .Framing}} · framing: {{.}}{{end}}
        {{with .Camera}} · camera: {{.}}{{end}}
      </div>
      {{end}}
      {{if .Notes}}<p class="muted seg-notes">{{.Notes}}</p>{{end}}
      <div class="card-actions">
        <form method="post" action="/content/{{$.Item.ID}}/shots/{{.ID}}/move">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="dir" value="up">
          <button type="submit" aria-label="Move '{{.Description}}' up">↑</button>
        </form>
        <form method="post" action="/content/{{$.Item.ID}}/shots/{{.ID}}/move">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="dir" value="down">
          <button type="submit" aria-label="Move '{{.Description}}' down">↓</button>
        </form>
        <form method="post" action="/content/{{$.Item.ID}}/shots/{{.ID}}/delete">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit" aria-label="Delete '{{.Description}}'">Delete</button>
        </form>
      </div>
    </li>
    {{end}}
  </ol>
  {{else}}
  <p>No shots yet. Add the first one below.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/shots" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="shot-desc">Description</label>
      <input id="shot-desc" name="description" required maxlength="300" autocomplete="off">
    </p>
    <p>
      <label for="shot-scene">Scene / location</label>
      <input id="shot-scene" name="scene" maxlength="120" autocomplete="off">
    </p>
    <p>
      <label for="shot-framing">Framing / angle</label>
      <input id="shot-framing" name="framing" maxlength="120" autocomplete="off">
    </p>
    <p>
      <label for="shot-camera">Camera <span class="muted">(multi-cam)</span></label>
      <input id="shot-camera" name="camera" maxlength="60" autocomplete="off">
    </p>
    <p>
      <label for="shot-status">Status</label>
      <select id="shot-status" name="status">
        {{range .ShotStatuses}}<option value="{{.}}">{{humanize .}}</option>{{end}}
      </select>
    </p>
    <p>
      <label for="shot-notes">Notes</label>
      <textarea id="shot-notes" name="notes" rows="2" autocomplete="off"></textarea>
    </p>
    <p><button type="submit">Add shot</button></p>
  </form>
</section>

<section aria-labelledby="labels-heading">
  <h2 id="labels-heading">Labels <span class="muted">(internal)</span></h2>

  {{if .ItemLabels}}
  <ul class="chips">
    {{range .ItemLabels}}
    <li>
      <span class="label-chip label-{{.Color}}">{{.Name}}</span>
      <form method="post" action="/content/{{$.Item.ID}}/labels/{{.ID}}/remove" class="inline-form">
        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
        <button type="submit" aria-label="Remove label {{.Name}}">✕</button>
      </form>
    </li>
    {{end}}
  </ul>
  {{else}}
  <p>No labels yet.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/labels" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input name="name" placeholder="Add a label" required maxlength="60" list="channel-labels" autocomplete="off">
    <datalist id="channel-labels">
      {{range .ChannelLabels}}<option value="{{.Name}}"></option>{{end}}
    </datalist>
    <label class="sr-only" for="label-color">Color</label>
    <select id="label-color" name="color">
      {{range .LabelColors}}<option value="{{.}}">{{humanize .}}</option>{{end}}
    </select>
    <button type="submit">Add label</button>
  </form>
</section>

<section aria-labelledby="tags-heading">
  <h2 id="tags-heading">Tags <span class="muted">(SEO keywords)</span></h2>

  {{if .ItemTags}}
  <ul class="chips">
    {{range .ItemTags}}
    <li>
      <span>{{.Name}}</span>
      <form method="post" action="/content/{{$.Item.ID}}/tags/{{.ID}}/remove" class="inline-form">
        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
        <button type="submit" aria-label="Remove tag {{.Name}}">✕</button>
      </form>
    </li>
    {{end}}
  </ul>
  <p class="muted">{{.TagLen}} / 500 characters</p>
  <textarea id="tag-list" class="rendered" readonly rows="2" aria-label="Tag list">{{.TagList}}</textarea>
  <p><button type="button" data-copy="tag-list">Copy tags</button></p>
  {{else}}
  <p>No tags yet.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/tags" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input name="name" placeholder="Add a keyword" required maxlength="100" list="channel-tags" autocomplete="off">
    <datalist id="channel-tags">
      {{range .ChannelTags}}<option value="{{.Name}}"></option>{{end}}
    </datalist>
    <button type="submit">Add tag</button>
  </form>
</section>

<section aria-labelledby="attr-heading">
  <h2 id="attr-heading">Attributions <span class="muted">(licensing credits)</span></h2>

  {{if .Attributions}}
  <table>
    <thead>
      <tr><th>Asset</th><th>Kind</th><th>Provider</th><th>License</th><th>Credit</th><th>In credits</th><th></th></tr>
    </thead>
    <tbody>
      {{range .Attributions}}
      <tr>
        <td>{{if .SourceURL}}<a href="{{.SourceURL}}" rel="noopener noreferrer nofollow" target="_blank">{{.Name}}</a>{{else}}{{.Name}}{{end}}
          {{if .LicenseID}}<div class="muted path">ID: {{.LicenseID}}</div>{{end}}</td>
        <td>{{humanize .Kind}}</td>
        <td>{{if .Provider}}{{.Provider}}{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{if .License}}{{.License}}{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{if .CreditText}}{{.CreditText}}{{else}}<span class="muted">auto</span>{{end}}</td>
        <td>
          <form method="post" action="/content/{{$.Item.ID}}/attributions/{{.ID}}/toggle" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" aria-label="Toggle '{{.Name}}' in credits block">{{if .IncludedInDescription}}☑{{else}}☐{{end}}</button>
          </form>
        </td>
        <td>
          <form method="post" action="/content/{{$.Item.ID}}/attributions/{{.ID}}/delete" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" aria-label="Delete attribution '{{.Name}}'">✕</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p>No attributions yet. Record third-party music, footage, images, or fonts so required credits make it into the description.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/attributions" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="a-name">Asset name</label>
      <input id="a-name" name="name" required maxlength="200" autocomplete="off">
    </p>
    <p>
      <label for="a-kind">Kind</label>
      <select id="a-kind" name="kind">
        {{range .AttributionKinds}}<option value="{{.}}">{{humanize .}}</option>{{end}}
      </select>
    </p>
    <p>
      <label for="a-provider">Provider / source</label>
      <input id="a-provider" name="provider" maxlength="200" autocomplete="off">
    </p>
    <p>
      <label for="a-license">License</label>
      <input id="a-license" name="license" maxlength="200" placeholder="e.g. CC-BY, royalty-free, licensed" autocomplete="off">
    </p>
    <p>
      <label for="a-license-id">License / reference ID <span class="muted">(optional)</span></label>
      <input id="a-license-id" name="license_id" maxlength="200" autocomplete="off">
    </p>
    <p>
      <label for="a-source-url">Source URL <span class="muted">(optional)</span></label>
      <input id="a-source-url" name="source_url" type="url" maxlength="500" autocomplete="off">
    </p>
    <p>
      <label for="a-credit-text">Required credit text <span class="muted">(optional; overrides the auto line)</span></label>
      <textarea id="a-credit-text" name="credit_text" rows="2" autocomplete="off"></textarea>
    </p>
    {{if .Media}}
    <p>
      <label for="a-media">Linked media asset <span class="muted">(optional)</span></label>
      <select id="a-media" name="media_asset_id">
        <option value="">— none —</option>
        {{range .Media}}<option value="{{.ID}}">{{.Filename}}</option>{{end}}
      </select>
    </p>
    {{end}}
    <p>
      <label><input type="checkbox" name="included" value="1" checked> Include in description credits block</label>
    </p>
    <p><button type="submit">Add attribution</button></p>
  </form>
</section>

<section aria-labelledby="desc-heading">
  <h2 id="desc-heading">Description</h2>

  <form method="post" action="/content/{{.Item.ID}}/description" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="d-intro">Intro</label>
      <textarea id="d-intro" name="intro" rows="3" autocomplete="off">{{.Description.Intro}}</textarea>
    </p>
    <p>
      <label for="d-chapters">Chapters</label>
      <textarea id="d-chapters" name="chapters" rows="5" autocomplete="off">{{.Description.Chapters}}</textarea>
    </p>
    <p>
      <label for="d-links">Links</label>
      <textarea id="d-links" name="links" rows="3" autocomplete="off">{{.Description.Links}}</textarea>
    </p>
    <p>
      <label for="d-sponsor">Sponsor blurb</label>
      <textarea id="d-sponsor" name="sponsor" rows="3" autocomplete="off">{{.Description.Sponsor}}</textarea>
    </p>
    <p>
      <label for="d-credits">Credits</label>
      <textarea id="d-credits" name="credits" rows="3" autocomplete="off">{{.Description.Credits}}</textarea>
    </p>
    <p>
      <label for="d-disclosure">Disclosure / affiliate</label>
      <textarea id="d-disclosure" name="disclosure" rows="2" autocomplete="off">{{.Description.Disclosure}}</textarea>
    </p>
    <p>
      <label for="d-hashtags">Hashtags</label>
      <textarea id="d-hashtags" name="hashtags" rows="2" autocomplete="off">{{.Description.Hashtags}}</textarea>
    </p>
    <p><button type="submit">Save description</button></p>
  </form>

  <form method="post" action="/content/{{.Item.ID}}/description/chapters" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit">Fill chapters from outline</button>
    <span class="muted">Overwrites the chapters block; save other edits first.</span>
  </form>

  <form method="post" action="/content/{{.Item.ID}}/description/sponsor" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit">Fill sponsor blurb from placements</button>
    <span class="muted">Overwrites the sponsor block; save other edits first.</span>
  </form>

  <form method="post" action="/content/{{.Item.ID}}/description/hashtags" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit">Fill hashtags from tags</button>
    <span class="muted">Overwrites the hashtags block; save other edits first.</span>
  </form>

  <form method="post" action="/content/{{.Item.ID}}/description/credits" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit">Fill credits from attributions</button>
    <span class="muted">Overwrites the credits block; save other edits first.</span>
  </form>

  <h3>Preview</h3>
  <textarea id="desc-rendered" class="rendered" readonly rows="12" aria-label="Rendered description">{{.DescriptionRendered}}</textarea>
  <p><button type="button" data-copy="desc-rendered">Copy description</button></p>
</section>

<section aria-labelledby="media-heading">
  <div class="seg-head">
    <h2 id="media-heading">Media</h2>
    {{if .Media}}
    <div class="card-actions">
      <form method="post" action="/content/{{.Item.ID}}/media/verify" class="inline-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit">Verify files</button>
      </form>
      {{if .ProbeAvailable}}
      <form method="post" action="/content/{{.Item.ID}}/media/probe" class="inline-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit">Probe metadata</button>
      </form>
      {{end}}
      {{if .ThumbAvailable}}
      <form method="post" action="/content/{{.Item.ID}}/media/previews" class="inline-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit">Generate previews</button>
      </form>
      {{end}}
    </div>
    {{end}}
  </div>

  {{if .Notice}}<p class="notice" role="status">{{.Notice}}</p>{{end}}

  {{if and .Media (not .ProbeAvailable)}}
  <p class="muted">Install ffmpeg (which provides ffprobe) to read media duration, resolution, and codec.</p>
  {{end}}

  {{if .Media}}
  <table>
    <thead>
      <tr><th scope="col">File</th><th scope="col">Kind</th><th scope="col">Size</th><th scope="col">Status</th><th scope="col">Actions</th></tr>
    </thead>
    <tbody>
      {{range .Media}}
      <tr{{if not .Present}} class="missing"{{end}}>
        <td>
          {{if .PreviewPath}}<img class="thumb" src="/content/{{$.Item.ID}}/media/{{.ID}}/preview" alt="Preview of {{.Filename}}" loading="lazy" width="160">{{end}}
          {{.Filename}}
          {{if not .Present}}<span class="badge-missing" title="{{.Path}}">missing</span>{{end}}
          <div class="muted path">{{.Path}}</div>
          {{if or .DurationSeconds .Width .Codec}}
          <div class="muted meta-line">
            {{if .DurationSeconds}}{{duration .DurationSeconds}}{{end}}
            {{if .Width}} · {{.Width}}×{{.Height}}{{end}}
            {{if .FPS}} · {{printf "%.2f" .FPS}} fps{{end}}
            {{if .Codec}} · {{.Codec}}{{end}}
            {{if .Container}} · {{.Container}}{{end}}
          </div>
          {{end}}
        </td>
        <td>{{humanize .Kind}}</td>
        <td>{{filesize .SizeBytes}}</td>
        <td>
          <form method="post" action="/content/{{$.Item.ID}}/media/{{.ID}}/status" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <label class="sr-only" for="media-status-{{.ID}}">Status</label>
            <select id="media-status-{{.ID}}" name="status">
              {{$cur := .Status}}
              {{range $.MediaStatuses}}<option value="{{.}}"{{if eq . $cur}} selected{{end}}>{{humanize .}}</option>{{end}}
            </select>
            <button type="submit">Set</button>
          </form>
        </td>
        <td>
          <form method="post" action="/content/{{$.Item.ID}}/media/{{.ID}}/delete" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit" aria-label="Remove '{{.Filename}}' from catalogue">Delete</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p>No media catalogued yet. Add a file below.</p>
  {{end}}

  <form method="post" action="/content/{{.Item.ID}}/media" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="media-path">File path <span class="muted">(absolute, within a media root)</span></label>
      <input id="media-path" name="path" required maxlength="1000" autocomplete="off" spellcheck="false">
    </p>
    <p>
      <label for="media-kind">Kind <span class="muted">(auto-detected if blank)</span></label>
      <select id="media-kind" name="kind">
        <option value="">— auto —</option>
        {{range .MediaKinds}}<option value="{{.}}">{{humanize .}}</option>{{end}}
      </select>
    </p>
    <p>
      <label for="media-status-new">Status</label>
      <select id="media-status-new" name="status">
        {{range .MediaStatuses}}<option value="{{.}}"{{if eq . "recorded"}} selected{{end}}>{{humanize .}}</option>{{end}}
      </select>
    </p>
    {{if .Shots}}
    <p>
      <label for="media-shot">Shot <span class="muted">(optional)</span></label>
      <select id="media-shot" name="shot_id">
        <option value="">— none —</option>
        {{range .Shots}}<option value="{{.ID}}">{{.Description}}</option>{{end}}
      </select>
    </p>
    {{end}}
    <p>
      <label for="media-notes">Notes</label>
      <textarea id="media-notes" name="notes" rows="2" autocomplete="off"></textarea>
    </p>
    <p><button type="submit">Add media</button></p>
  </form>

  <form method="post" action="/content/{{.Item.ID}}/media/scan" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="scan-dir">Scan a folder <span class="muted">(absolute, within a media root; catalogues all media files inside)</span></label>
      <input id="scan-dir" name="dir" required maxlength="1000" autocomplete="off" spellcheck="false">
    </p>
    <p><button type="submit">Scan folder</button></p>
  </form>
</section>

<section aria-labelledby="sponsor-heading">
  <h2 id="sponsor-heading">Sponsors</h2>

  {{if .Placements}}
  {{range .Placements}}
  <div class="placement">
    <div class="seg-head">
      <strong>{{.SponsorName}} — {{.CampaignName}}</strong>
      <span class="muted">
        {{if .Deadline}}due {{.Deadline}}{{end}}
        <form method="post" action="/content/{{$.Item.ID}}/placements/{{.ID}}/delete" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit">Detach</button>
        </form>
      </span>
    </div>

    <ul class="checklist">
      {{range .Deliverables}}
      <li>
        <form method="post" action="/content/{{$.Item.ID}}/placements/{{.PlacementID}}/deliverables/{{.ID}}/toggle" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit" aria-label="Toggle '{{.Description}}' done">{{if .Done}}☑{{else}}☐{{end}}</button>
        </form>
        <span{{if .Done}} class="done"{{end}}>{{.Description}}</span>
        <form method="post" action="/content/{{$.Item.ID}}/placements/{{.PlacementID}}/deliverables/{{.ID}}/delete" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <button type="submit" aria-label="Delete '{{.Description}}'">✕</button>
        </form>
      </li>
      {{end}}
    </ul>

    <form method="post" action="/content/{{$.Item.ID}}/placements/{{.ID}}/deliverables" class="inline-form">
      <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
      <input name="description" placeholder="New deliverable" required maxlength="300" autocomplete="off">
      <button type="submit">Add deliverable</button>
    </form>
  </div>
  {{end}}
  {{else}}
  <p>No sponsors attached.</p>
  {{end}}

  {{if .CampaignOptions}}
  <form method="post" action="/content/{{.Item.ID}}/placements" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="campaign_id">Attach campaign</label>
      <select id="campaign_id" name="campaign_id" required>
        {{range .CampaignOptions}}<option value="{{.ID}}">{{.Label}}</option>{{end}}
      </select>
    </p>
    <p>
      <label for="placement-deadline">Deadline</label>
      <input id="placement-deadline" name="deadline" type="date">
    </p>
    <p><button type="submit">Attach campaign</button></p>
  </form>
  {{else}}
  <p class="muted">Create a <a href="/sponsors">sponsor campaign</a> first to attach it here.</p>
  {{end}}
</section>

<section aria-labelledby="thumb-heading">
  <h2 id="thumb-heading">Thumbnails</h2>
  {{if .Thumbnails}}
  <div class="thumb-grid">
    {{range .Thumbnails}}
    <a class="thumb-card" href="/content/{{$.Item.ID}}/thumbnails/{{.ID}}">
      <img src="/content/{{$.Item.ID}}/thumbnails/{{.ID}}/render.png" alt="{{.Name}}" width="240" loading="lazy">
      <span>{{.Name}}</span>
    </a>
    {{end}}
  </div>
  {{end}}
  <form method="post" action="/content/{{.Item.ID}}/thumbnails" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="thumb-name">New thumbnail name</label>
      <input id="thumb-name" name="name" required maxlength="120" autocomplete="off">
    </p>
    <p><button type="submit">Create thumbnail</button></p>
  </form>
</section>

<p class="muted">More features attach here in later slices.</p>
{{end}}
