{{define "content"}}
<h1>Content</h1>

{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}

{{if .HasChannels}}
<form method="post" action="/content" class="stack">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <p>
    <label for="channel_id">Channel</label>
    <select id="channel_id" name="channel_id" required>
      {{range .Channels}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
    </select>
  </p>
  <p>
    <label for="type">Type</label>
    <select id="type" name="type" required>
      {{range .Types}}<option value="{{.}}">{{humanize .}}</option>{{end}}
    </select>
  </p>
  <p>
    <label for="mode">Creator mode <span class="muted">(video / short)</span></label>
    <select id="mode" name="mode">
      <option value="">— none —</option>
      {{range .Modes}}<option value="{{.}}">{{humanize .}}</option>{{end}}
    </select>
  </p>
  <p>
    <label for="title">Title</label>
    <input id="title" name="title" required maxlength="300" autocomplete="off">
  </p>
  <p><button type="submit">Add content item</button></p>
</form>
{{else}}
<p>Create a <a href="/channels">channel</a> first, then you can add content items.</p>
{{end}}

<section aria-label="Pipeline board">
  <div class="board">
    {{range .Columns}}
    <div class="board-col">
      <h2>{{humanize .Status}} <span class="count">{{len .Items}}</span></h2>
      {{range .Items}}
      <article class="card">
        <strong><a href="/content/{{.ID}}">{{.Title}}</a></strong>{{if .HasSponsor}} <span class="badge-sponsor">sponsored</span>{{end}}
        <div class="muted">{{.ChannelName}} · {{humanize .Type}}{{if .Mode}} · {{humanize .Mode}}{{end}}</div>
        <div class="card-actions">
          {{if .PrevStatus}}
          <form method="post" action="/content/{{.ID}}/status">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="status" value="{{.PrevStatus}}">
            <input type="hidden" name="return_to" value="/content">
            <button type="submit" aria-label="Move '{{.Title}}' back to {{humanize .PrevStatus}}">←</button>
          </form>
          {{end}}
          {{if .NextStatus}}
          <form method="post" action="/content/{{.ID}}/status">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="status" value="{{.NextStatus}}">
            <input type="hidden" name="return_to" value="/content">
            <button type="submit" aria-label="Advance '{{.Title}}' to {{humanize .NextStatus}}">→</button>
          </form>
          {{end}}
        </div>
      </article>
      {{else}}
      <p class="muted empty">—</p>
      {{end}}
    </div>
    {{end}}
  </div>
</section>
{{end}}
