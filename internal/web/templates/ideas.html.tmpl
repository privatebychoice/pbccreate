{{define "content"}}
<h1>Ideas <span class="muted">(idea log)</span></h1>
<p class="muted">Capture topics fast, score them (ICE = impact × confidence ÷ effort, each 0–10), then promote the best into the pipeline.</p>

{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}

{{if .HasChannels}}
<form method="post" action="/ideas" class="stack">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <p>
    <label for="channel_id">Channel</label>
    <select id="channel_id" name="channel_id" required>
      {{range .Channels}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
    </select>
  </p>
  <p>
    <label for="title">Title</label>
    <input id="title" name="title" required maxlength="300" autocomplete="off">
  </p>
  <p>
    <label for="note">Note</label>
    <textarea id="note" name="note" rows="2" autocomplete="off"></textarea>
  </p>
  <p>
    <label for="source">Source <span class="muted">(where it came from)</span></label>
    <input id="source" name="source" maxlength="300" autocomplete="off">
  </p>
  <div class="inline-form">
    <span>
      <label for="impact">Impact</label>
      <input id="impact" name="impact" type="number" min="0" max="10" value="0" inputmode="numeric">
    </span>
    <span>
      <label for="confidence">Confidence</label>
      <input id="confidence" name="confidence" type="number" min="0" max="10" value="0" inputmode="numeric">
    </span>
    <span>
      <label for="effort">Effort</label>
      <input id="effort" name="effort" type="number" min="0" max="10" value="0" inputmode="numeric">
    </span>
  </div>
  <p><button type="submit">Add idea</button></p>
</form>
{{else}}
<p>Create a <a href="/channels">channel</a> first, then you can capture ideas.</p>
{{end}}

{{if .Ideas}}
<table>
  <thead>
    <tr><th scope="col">Score</th><th scope="col">Title</th><th scope="col">Channel</th><th scope="col">ICE</th><th scope="col">Status</th></tr>
  </thead>
  <tbody>
    {{range .Ideas}}
    <tr>
      <td>{{if gt .Score 0.0}}{{printf "%.1f" .Score}}{{else}}<span class="muted">—</span>{{end}}</td>
      <td><a href="/ideas/{{.ID}}">{{.Title}}</a>
        {{if .PromotedContentItemID}} <a class="badge-sponsor" href="/content/{{.PromotedContentItemID}}">promoted</a>{{end}}</td>
      <td>{{.ChannelName}}</td>
      <td class="muted">{{.Impact}}/{{.Confidence}}/{{.Effort}}</td>
      <td>{{humanize .Status}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p>No ideas yet. Capture your first one above.</p>
{{end}}
{{end}}
