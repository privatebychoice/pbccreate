{{define "content"}}
<h1>Data <span class="muted">(settings, backup &amp; import)</span></h1>

{{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}
{{if .Notice}}<p class="notice" role="status">{{.Notice}}</p>{{end}}

<section aria-labelledby="projectroot-heading">
  <h2 id="projectroot-heading">DaVinci project root</h2>
  <p class="muted">
    The base folder that holds your scaffolded Resolve project folders — one
    subfolder is created per video. This is not the app's data directory and not a
    single Resolve project. Use an absolute path.
  </p>
  <p>
    Currently:
    {{if .ProjectRootEffective}}<code>{{.ProjectRootEffective}}</code>
      {{if eq .ProjectRootSource "env"}}<span class="muted">(from PBCCREATE_PROJECT_ROOT — overrides the value below)</span>
      {{else}}<span class="muted">(stored setting)</span>{{end}}
    {{else}}<span class="badge-blocked">not set</span> <span class="muted">— scaffolding is disabled until this is set.</span>{{end}}
  </p>
  <form method="post" action="/data/project-root" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="project_root">Project root path</label>
      <input id="project_root" name="project_root" value="{{.ProjectRootStored}}" maxlength="1000"
        autocomplete="off" spellcheck="false" placeholder="/Users/you/Video/Projects">
    </p>
    {{if .ProjectRootEnv}}<p class="muted">Note: PBCCREATE_PROJECT_ROOT is set in the environment and takes precedence over this stored value. Clear the env var to use the value here.</p>{{end}}
    <p><button type="submit">Save project root</button> <span class="muted">Leave blank and save to clear.</span></p>
  </form>
</section>

<section aria-labelledby="backup-heading">
  <h2 id="backup-heading">Backup</h2>
  <p class="muted">Download a consistent, standalone copy of the whole database. It opens in any SQLite tool — your data, no lock-in.</p>
  <p><a href="/data/backup"><button type="button">Download backup (.db)</button></a></p>
</section>

<section aria-labelledby="import-heading">
  <h2 id="import-heading">Bulk import content items</h2>
  <p class="muted">
    Upload a CSV to backfill content items (e.g. already-published videos). Header row required.
    Columns: <code>channel</code>, <code>title</code> (required); <code>type</code>, <code>mode</code>, <code>status</code> (optional).
    The channel must already exist. Type defaults to <code>video</code>.
  </p>
  <p class="muted">
    Valid types: {{range $i, $t := .Types}}{{if $i}}, {{end}}<code>{{$t}}</code>{{end}}.
    Valid statuses: {{range $i, $s := .Statuses}}{{if $i}}, {{end}}<code>{{$s}}</code>{{end}}.
  </p>

  {{with .Result}}
  <p class="notice" role="status">Imported {{.Added}} item(s); skipped {{len .Skipped}}.</p>
  {{if .Skipped}}
  <ul>
    {{range .Skipped}}<li class="muted">{{.}}</li>{{end}}
  </ul>
  {{end}}
  {{end}}

  <form method="post" action="/data/import" enctype="multipart/form-data" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p>
      <label for="import-file">CSV file <span class="muted">(up to 8 MB)</span></label>
      <input id="import-file" name="file" type="file" accept=".csv,text/csv" required>
    </p>
    <p><button type="submit">Import CSV</button></p>
  </form>

  <h3>Example</h3>
  <textarea class="rendered" readonly rows="4" aria-label="CSV example">channel,title,type,mode,status
TUL,Best VPN 2026,video,single_cam,published
TUL,Quick tip,short,,scheduled
PBC,Why privacy matters,blog,,published</textarea>
</section>
{{end}}
